{
  "name": "pokedex",
  "version": "1.0.0",
  "private": true,
  "packageManager": "yarn@4.18.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "mcp": "tsx src/mcp/server.ts",
    "mcp:inspect": "mcp-inspector tsx src/mcp/server.ts",
    "prepare": "husky",
    "fixtures": "tsx scripts/record-fixtures.ts",
    "battle-pool:record": "tsx scripts/record-battle-pool.ts"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml}": "prettier --write"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "lucide-react": "^1.66.0",
    "next": "16",
    "react": "19",
    "react-dom": "19",
    "server-only": "^0.0.1",
    "zod": "4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@modelcontextprotocol/inspector": "^2.13.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "4",
    "@types/node": "20",
    "@types/react": "19",
    "@types/react-dom": "19",
    "eslint": "9",
    "eslint-config-next": "16",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "4",
    "tsx": "^4.23.15",
    "typescript": "5",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
