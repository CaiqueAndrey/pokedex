POKEAPI_BASE_URL=https://pokeapi.co/api/v2

# Optional. Absolute site URL for metadata; on Vercel it is detected automatically.
# NEXT_PUBLIC_SITE_URL=https://example.com

# Optional. Override the GraphQL endpoint used by the gym draft pool.
# POKEAPI_GRAPHQL_URL=https://beta.pokeapi.co/graphql/v1beta

# Optional. Set to 1 to skip image optimization (e.g. if a free hosting quota runs out).
# IMAGES_UNOPTIMIZED=1
